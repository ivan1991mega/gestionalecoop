# Railway inietta DATABASE_URL automaticamente quando colleghi il plugin Postgres.
# In locale, copia questo file in ".env" e metti la tua stringa:
DATABASE_URL=postgresql://user:password@localhost:5432/bottega
# Metti "true" solo se il tuo Postgres richiede SSL:
PGSSL=false
# Facoltativo: limita il CORS al dominio del frontend (GitHub Pages), es:
# CORS_ORIGIN=https://tuonome.github.io
PORT=3000

# --- Accesso (login) ---
# Default: admin / admin. Cambiali qui per una password tua.
AUTH_USER=admin
AUTH_PASS=admin
# Segreto per firmare i token di sessione (metti una stringa lunga a caso).
# Se lo lasci vuoto ne viene generato uno nuovo a ogni riavvio (gli utenti dovranno rifare il login).
AUTH_SECRET=
